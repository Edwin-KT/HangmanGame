<Window x:Class="HangmanGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:HangmanGame.ViewModels"
        Title="Spânzurătoarea" Height="720" Width="1280" 
        Background="#FFF9E6" 
        FontFamily="Comic Sans MS">
	<Window.DataContext>
		<viewmodels:LoginViewModel/>
	</Window.DataContext>

	<Window.Resources>
		<Style TargetType="Button" x:Key="DoodleButton">
			<Setter Property="Background" Value="#FFD166"/>
			<Setter Property="BorderBrush" Value="#2D2D2D"/>
			<Setter Property="BorderThickness" Value="3"/>
			<Setter Property="Foreground" Value="#2D2D2D"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="FontSize" Value="18"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Margin" Value="10"/>
			<Setter Property="Padding" Value="15,5"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="15">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="#FFC436"/>
				</Trigger>
				<Trigger Property="IsEnabled" Value="False">
					<Setter Property="Background" Value="#E0E0E0"/>
					<Setter Property="Foreground" Value="#999999"/>
					<Setter Property="BorderBrush" Value="#999999"/>
				</Trigger>
			</Style.Triggers>
		</Style>

		<Style TargetType="TextBox" x:Key="DoodleTextBox">
			<Setter Property="BorderBrush" Value="#2D2D2D"/>
			<Setter Property="BorderThickness" Value="3"/>
			<Setter Property="Background" Value="White"/>
			<Setter Property="Padding" Value="8"/>
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10">
							<ScrollViewer x:Name="PART_ContentHost"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid Margin="25">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0" Text="Jocul Spânzurătoarea" 
                   FontSize="40" FontWeight="Bold" HorizontalAlignment="Center" 
                   Foreground="#2D2D2D" Margin="0,0,0,30"/>

		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="1.2*"/>
				<ColumnDefinition Width="40"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<Border Grid.Column="0" BorderBrush="#2D2D2D" BorderThickness="3" CornerRadius="15" Background="White" Padding="20">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<TextBlock Text="Alege jucătorul:" FontSize="24" FontWeight="Bold" Margin="0,0,0,15" Foreground="#2D2D2D"/>

					<ListBox Grid.Row="1" ItemsSource="{Binding Users}" 
                             SelectedItem="{Binding SelectedUser}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
						<ListBox.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel Orientation="Horizontal" />
							</ItemsPanelTemplate>
						</ListBox.ItemsPanel>
						<ListBox.ItemTemplate>
							<DataTemplate>
								<Border BorderBrush="#2D2D2D" BorderThickness="2" CornerRadius="12" 
                                        Margin="8" Padding="10" Background="#FFF9E6" Width="110" Height="130">
									<StackPanel VerticalAlignment="Center">
										<Image Source="{Binding ProfileImagePath}" Width="70" Height="70" Margin="0,0,0,10"/>
										<TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" 
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
									</StackPanel>
								</Border>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</Grid>
			</Border>

			<Border Grid.Column="2" BorderBrush="#2D2D2D" BorderThickness="3" CornerRadius="15" Background="White" Padding="20">
				<ScrollViewer VerticalScrollBarVisibility="Auto" BorderThickness="0">
					<StackPanel>
						<TextBlock Text="Jucător nou:" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Foreground="#2D2D2D"/>

						<TextBlock Text="Nume" FontSize="18" Margin="0,0,0,5"/>
						<TextBox Text="{Binding NewUserName, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource DoodleTextBox}" Margin="0,0,0,20"/>

						<TextBlock Text="Alege-ți avatarul" FontSize="18" Margin="0,0,0,5"/>
						<ListBox ItemsSource="{Binding AvailableAvatars}" 
                     SelectedItem="{Binding SelectedAvatar}" 
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
							<ListBox.ItemsPanel>
								<ItemsPanelTemplate>
									<WrapPanel Orientation="Horizontal" />
								</ItemsPanelTemplate>
							</ListBox.ItemsPanel>
							<ListBox.ItemTemplate>
								<DataTemplate>
									<Border BorderBrush="#2D2D2D" BorderThickness="2" CornerRadius="10" Margin="5" Padding="5" Background="White">
										<Image Source="{Binding}" Width="50" Height="50"/>
									</Border>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>

						<Button Content="Adaugă Jucător" Command="{Binding NewUserCommand}" 
                    Style="{StaticResource DoodleButton}" Margin="0,25,0,0"/>
					</StackPanel>
				</ScrollViewer>
			</Border>
		</Grid>

		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
			<Button Content="Șterge Jucătorul" Command="{Binding DeleteUserCommand}" 
                    Style="{StaticResource DoodleButton}" Background="#EF476F" Foreground="White"/>

			<Button Content="JOACĂ" Command="{Binding PlayCommand}" 
				Style="{StaticResource DoodleButton}" Background="#06D6A0" Foreground="White" FontSize="26" Padding="30,10" Width="290"/>

			<Button Content="Ieșire" Command="{Binding ExitCommand}" Style="{StaticResource DoodleButton}" Background="#E0E0E0"/>
		</StackPanel>
	</Grid>
</Window>
<Window x:Class="HangmanGame.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spânzurătoarea - La Joacă!" Height="720" Width="1080"
        Background="#FFF9E6" FontFamily="Comic Sans MS">

	<Window.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis"/>
		<Style TargetType="Button" x:Key="LetterButton">
			<Setter Property="Background" Value="White"/>
			<Setter Property="BorderBrush" Value="#2D2D2D"/>
			<Setter Property="BorderThickness" Value="2"/>
			<Setter Property="Foreground" Value="#2D2D2D"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="FontSize" Value="20"/>
			<Setter Property="Width" Value="45"/>
			<Setter Property="Height" Value="45"/>
			<Setter Property="Margin" Value="5"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="#FFD166"/>
				</Trigger>
				<Trigger Property="IsEnabled" Value="False">
					<Setter Property="Visibility" Value="Hidden"/>
				</Trigger>
			</Style.Triggers>
		</Style>
	</Window.Resources>

	<DockPanel>
		<Menu DockPanel.Dock="Top" Background="#FFD166" FontSize="16" BorderBrush="#2D2D2D" BorderThickness="0,0,0,3" Padding="5">
    <MenuItem Header="File">
        <MenuItem Header="New Game" Command="{Binding NewGameCommand}"/>
        <MenuItem Header="Open Game" Command="{Binding OpenGameCommand}"/>
        <MenuItem Header="Save Game" Command="{Binding SaveGameCommand}"/>
        <MenuItem Header="Statistics"/>
        <Separator/>
        <MenuItem Header="Cancel" Command="{Binding CancelCommand}"/>
    </MenuItem>
		<MenuItem Header="Categories">
			<MenuItem Header="All categories" Command="{Binding ChangeCategoryCommand}" CommandParameter="All categories" IsCheckable="True" IsChecked="{Binding IsAllCategoriesChecked, Mode=OneWay}"/>
			<MenuItem Header="Cars" Command="{Binding ChangeCategoryCommand}" CommandParameter="Cars" IsCheckable="True" IsChecked="{Binding IsCarsChecked, Mode=OneWay}"/>
			<MenuItem Header="Movies" Command="{Binding ChangeCategoryCommand}" CommandParameter="Movies" IsCheckable="True" IsChecked="{Binding IsMoviesChecked, Mode=OneWay}"/>
			<MenuItem Header="Cities" Command="{Binding ChangeCategoryCommand}" CommandParameter="Cities" IsCheckable="True" IsChecked="{Binding IsCitiesChecked, Mode=OneWay}"/>
			<MenuItem Header="Rivers" Command="{Binding ChangeCategoryCommand}" CommandParameter="Rivers" IsCheckable="True" IsChecked="{Binding IsRiversChecked, Mode=OneWay}"/>
		</MenuItem>
			<MenuItem Header="Help">
        <MenuItem Header="About" Command="{Binding AboutCommand}"/>
    </MenuItem>
</Menu>

		<Grid Margin="20">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="1.2*"/>
				<ColumnDefinition Width="2*"/>
			</Grid.ColumnDefinitions>

			<StackPanel Grid.Column="0" Margin="0,0,20,0">

				<StackPanel Orientation="Horizontal" Margin="0,0,0,30">
					<Border BorderBrush="#2D2D2D" BorderThickness="2" CornerRadius="10" Background="White" Padding="5">
						<Image Source="{Binding CurrentUser.ProfileImagePath}" Width="60" Height="60"/>
					</Border>
					<TextBlock Text="{Binding CurrentUser.Name}" FontSize="24" FontWeight="Bold" 
					           VerticalAlignment="Center" Margin="15,0,0,0" Foreground="#2D2D2D" 
					           TextTrimming="CharacterEllipsis" MaxWidth="200"/>
				</StackPanel>

				<Border BorderBrush="#2D2D2D" BorderThickness="3" CornerRadius="15" Background="White" Height="350" Width="300" HorizontalAlignment="Left" ClipToBounds="True">
					<Grid>
						<Image Source="{Binding HangmanImagePath}" Stretch="Uniform"/>

						<Image Source="{Binding CurrentUser.ProfileImagePath}" 
						       Visibility="{Binding IsAvatarVisible, Converter={StaticResource BoolToVis}}"
						       Width="65" Height="65" 
						       HorizontalAlignment="Left" VerticalAlignment="Top"
						       Margin="147,101,0,0"/>
					</Grid>
				</Border>
			</StackPanel>

			<StackPanel Grid.Column="1" VerticalAlignment="Center">

				<Border BorderBrush="#2D2D2D" BorderThickness="2" CornerRadius="10" Background="White" Padding="20,10" Margin="0,0,0,30" HorizontalAlignment="Center">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="{Binding CurrentLevel, StringFormat='Nivel: {0}/3'}" FontSize="22" FontWeight="Bold" Foreground="#06D6A0" Margin="0,0,30,0"/>
						<TextBlock Text="{Binding TimeLeft, StringFormat='Timp rămas: {0}s'}" FontSize="22" FontWeight="Bold" Foreground="#EF476F"/>
					</StackPanel>
				</Border>

				<TextBlock Text="{Binding DisplayedWord}" FontSize="60" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

				<TextBlock Text="{Binding Mistakes, StringFormat='Greșeli: {0}'}" FontSize="20" FontWeight="Bold" Foreground="#EF476F" HorizontalAlignment="Center" Margin="0,0,0,40"/>

				<ItemsControl ItemsSource="{Binding Keyboard}" HorizontalAlignment="Center">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel Orientation="Horizontal" MaxWidth="500" HorizontalAlignment="Center"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Button Content="{Binding Character}" 
							        Command="{Binding DataContext.GuessLetterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
							        CommandParameter="{Binding}"
							        IsEnabled="{Binding IsEnabled}"
							        Style="{StaticResource LetterButton}"/>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</Grid>
	</DockPanel>
</Window>